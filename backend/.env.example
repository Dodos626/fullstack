NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_db
DB_TEST_NAME=app_db_test
DB_SSL=false

JWT_ACCESS_SECRET=replace-with-at-least-16-characters
JWT_REFRESH_SECRET=replace-with-a-different-secret
JWT_ISSUER=fullstack-api
JWT_ACCESS_AUDIENCE=fullstack-web

# Use .lvh.me in development to share the refresh cookie across role subdomains.
COOKIE_DOMAIN=.lvh.me
COOKIE_SECURE=false
CORS_ORIGINS=http://lvh.me:5173,http://user.lvh.me:5173,http://guest.lvh.me:5173,http://admin.lvh.me:5173,http://localhost:5173,http://127.0.0.1:5173
APP_ROOT_DOMAIN=lvh.me