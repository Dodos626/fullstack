{$APP_DOMAIN}, user.{$APP_DOMAIN}, guest.{$APP_DOMAIN}, admin.{$APP_DOMAIN} {
	handle /api/* {
		reverse_proxy backend:5000
	}

	handle {
		root * /srv/main
		try_files {path} /index.html
		file_server
	}
}

gamefinder.{$APP_DOMAIN} {
	handle /api/* {
		reverse_proxy backend:5000
	}

	handle /socket.io/* {
		reverse_proxy backend:5000
	}

	handle {
		root * /srv/apps/gamefinder
		try_files {path} {path}/ /index.html
		file_server
	}
}
