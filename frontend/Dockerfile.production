FROM node:22-bookworm-slim AS portfolio-build
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ARG APP_DOMAIN
ENV VITE_API_URL=/api \
    VITE_APP_ROOT_DOMAIN=${APP_DOMAIN} \
    VITE_APP_PROTOCOL=https \
    VITE_APP_MAIN_URL=https://${APP_DOMAIN} \
    VITE_APP_USER_URL=https://user.${APP_DOMAIN} \
    VITE_APP_GUEST_URL=https://guest.${APP_DOMAIN} \
    VITE_APP_ADMIN_URL=https://admin.${APP_DOMAIN} \
    VITE_APP_GAMEFINDER_URL=https://gamefinder.${APP_DOMAIN}
RUN npm run build

FROM node:22-bookworm-slim AS gamefinder-build
WORKDIR /app/apps/gamefinder
COPY apps/gamefinder/package*.json ./
RUN npm ci
COPY apps/gamefinder/ ./
ARG APP_DOMAIN
ENV NEXT_PUBLIC_SOCKET_URL=https://gamefinder.${APP_DOMAIN} \
    NEXT_PUBLIC_API_URL=https://gamefinder.${APP_DOMAIN}/api \
    NEXT_PUBLIC_PORTFOLIO_URL=https://${APP_DOMAIN}
RUN npm run build

FROM caddy:2-alpine
COPY --from=portfolio-build /app/frontend/dist /srv/main
COPY --from=gamefinder-build /app/apps/gamefinder/out /srv/apps/gamefinder
COPY frontend/Caddyfile /etc/caddy/Caddyfile
